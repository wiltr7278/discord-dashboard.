<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #050505;
    color: #ffffff;
}

/* NAVBAR */

.navbar {
    height: 72px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #222;
    background: #050505;
    position: sticky;
    top: 0;
    z-index: 10;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 900;
}

.logo {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 23px;
    font-weight: 900;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
}

.nav-links a {
    color: #999;
    text-decoration: none;
    font-size: 14px;
}

.nav-links a:hover {
    color: #fff;
}

.add-button {
    background: #fff !important;
    color: #000 !important;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 800;
}


/* HERO */

.hero {
    max-width: 1050px;
    margin: auto;
    text-align: center;
    padding: 115px 20px 100px;
}

.badge {
    display: inline-block;
    padding: 8px 15px;
    border: 1px solid #292929;
    border-radius: 30px;
    background: #0d0d0d;
    color: #aaa;
    font-size: 13px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(50px, 9vw, 90px);
    line-height: 1;
    letter-spacing: -4px;
    font-weight: 900;
}

.hero h1 span {
    color: #777;
}

.hero p {
    max-width: 620px;
    margin: 25px auto;
    color: #999;
    font-size: 17px;
    line-height: 1.7;
}

.buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
}

.button {
    display: inline-block;
    padding: 14px 24px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 800;
    transition: 0.2s;
}

.button:hover {
    transform: translateY(-2px);
}

.white-button {
    background: #fff;
    color: #000;
}

.dark-button {
    background: #101010;
    border: 1px solid #333;
    color: #fff;
}


/* HELP / COMMAND */

.help {
    max-width: 800px;
    margin: auto;
    padding: 20px 20px 110px;
}

.section-title {
    text-align: center;
    margin-bottom: 35px;
}

.section-title h2 {
    font-size: 38px;
    font-weight: 900;
}

.section-title p {
    color: #777;
    margin-top: 10px;
}

.command-card {
    background: #0d0d0d;
    border: 1px solid #242424;
    border-radius: 15px;
    padding: 30px;
    transition: 0.2s;
}

.command-card:hover {
    border-color: #444;
    transform: translateY(-2px);
}

.command {
    display: inline-block;
    padding: 9px 13px;
    background: #181818;
    border: 1px solid #333;
    border-radius: 8px;
    color: #fff;
    font-family: monospace;
    font-size: 15px;
    margin-bottom: 15px;
}

.command-card h3 {
    font-size: 20px;
    margin-bottom: 8px;
}

.command-card p {
    color: #777;
    line-height: 1.6;
    font-size: 14px;
}


/* SUPPORT */

.support {
    max-width: 950px;
    margin: 0 auto 100px;
    padding: 60px 25px;
    text-align: center;
    background: linear-gradient(135deg, #111, #080808);
    border: 1px solid #292929;
    border-radius: 18px;
}

.support h2 {
    font-size: 38px;
    font-weight: 900;
}

.support p {
    max-width: 550px;
    margin: 12px auto 28px;
    color: #777;
    line-height: 1.6;
}


/* FOOTER */

footer {
    border-top: 1px solid #222;
    padding: 30px 7%;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
    color: #666;
    font-size: 13px;
}


/* MOBILE */

@media (max-width: 700px) {

    .navbar {
        padding: 0 17px;
    }

    .nav-links a:not(.add-button) {
        display: none;
    }

    .add-button {
        padding: 9px 12px;
        font-size: 12px;
    }

    .hero {
        padding: 80px 18px 70px;
    }

    .hero h1 {
        font-size: 55px;
        letter-spacing: -3px;
    }

    .hero p {
        font-size: 15px;
    }

    .help {
        padding-left: 18px;
        padding-right: 18px;
    }

    .support {
        margin-left: 18px;
        margin-right: 18px;
    }

    footer {
        justify-content: center;
        text-align: center;
    }
}
</style>
</head>

<body>


<!-- NAVBAR -->

<nav class="navbar">

    <div class="brand">
        <div class="logo">D</div>
        <span>𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘</span>
    </div>

    <div class="nav-links">

        <a href="#help">Help</a>

        <a href="#support">Support</a>

        <a
            class="add-button"
            href="https://discord.com/oauth2/authorize?client_id=1535810857257410594&permissions=8&scope=bot%20applications.commands"
            target="_blank">
            Add to Discord
        </a>

    </div>

</nav>


<!-- HERO -->

<section class="hero">

    <div class="badge">
        ✦ Discord Bot
    </div>

    <h1>
        𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘<br>
        <span>simple. powerful.</span>
    </h1>

    <p>
        𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘 is your Discord bot.
        Use its commands directly inside your Discord server.
    </p>

    <div class="buttons">

        <a
            class="button white-button"
            href="https://discord.com/oauth2/authorize?client_id=1535810857257410594&permissions=8&scope=bot%20applications.commands"
            target="_blank">
            Add 𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘
        </a>

        <a
            class="button dark-button"
            href="#support">
            Support Server
        </a>

    </div>

</section>


<!-- HELP -->

<section class="help" id="help">

    <div class="section-title">

        <h2>𝙃𝙚𝙡𝙥</h2>

        <p>
            Available command
        </p>

    </div>


    <div class="command-card">

        <div class="command">
            /help
        </div>

        <h3>Help</h3>

        <p>
            Shows the available commands and information
            about 𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘.
        </p>

    </div>

</section>


<!-- SUPPORT -->

<section class="support" id="support">

    <h2>𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘 Support</h2>

    <p>
        Need help? Join the support server and
        talk with the 𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘 community.
    </p>

    <a
        class="button white-button"
        href="https://discord.gg/YOURINVITE"
        target="_blank">
        Join Support Server
    </a>

</section>


<!-- FOOTER -->

<footer>

    <span>© 2026 𝐒𝐄𝐂𝐔𝐑𝐈𝐓𝐘</span>

    <span>Discord Bot</span>

</footer>


</body>
</html>
